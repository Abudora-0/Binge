<!-- ── Custom Confirm Modal ── -->
<div id="confirmModal" class="fixed inset-0 z-[999] flex items-center justify-center" style="display:none !important">
  <!-- Backdrop -->
  <div id="confirmBackdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <!-- Dialog -->
  <div class="relative bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
    <!-- Icon + Title -->
    <div class="px-6 pt-6 pb-4 flex flex-col items-center text-center">
      <div id="confirmIconWrap" class="w-14 h-14 rounded-full flex items-center justify-center mb-4 bg-red-500/15 border border-red-500/25">
        <i id="confirmIcon" data-lucide="alert-triangle" class="w-7 h-7 text-red-400"></i>
      </div>
      <h3 id="confirmTitle" class="text-white font-bold text-base mb-1.5">Are you sure?</h3>
      <p id="confirmMessage" class="text-gray-400 text-sm leading-relaxed"></p>
    </div>
    <!-- Buttons -->
    <div class="flex gap-3 px-6 pb-6">
      <button onclick="dismissConfirm()"
        class="flex-1 bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-2.5 rounded-xl text-sm transition">
        Cancel
      </button>
      <button id="confirmOkBtn"
        class="flex-1 bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-xl text-sm transition">
        Confirm
      </button>
    </div>
  </div>
</div>

<script>
  let _confirmCallback = null;

  function showConfirm(message, onConfirm, { title = 'Are you sure?', okLabel = 'Confirm', icon = 'alert-triangle', color = 'red' } = {}) {
    document.getElementById('confirmTitle').textContent   = title;
    document.getElementById('confirmMessage').textContent = message;
    document.getElementById('confirmOkBtn').textContent   = okLabel;
    document.getElementById('confirmIcon').setAttribute('data-lucide', icon);
    document.getElementById('confirmModal').style.display = 'flex';
    _confirmCallback = onConfirm;
    if (typeof lucide !== 'undefined') lucide.createIcons();
    // Close on backdrop click
    document.getElementById('confirmBackdrop').onclick = dismissConfirm;
  }

  function dismissConfirm() {
    document.getElementById('confirmModal').style.display = 'none';
    _confirmCallback = null;
  }

  document.getElementById('confirmOkBtn').addEventListener('click', () => {
    document.getElementById('confirmModal').style.display = 'none';
    if (_confirmCallback) _confirmCallback();
    _confirmCallback = null;
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dismissConfirm();
  });
</script>
